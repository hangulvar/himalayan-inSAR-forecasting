# ==============================================================================
# .env Template for Geospatial APIs & Environment Settings
# ==============================================================================
# Copy this file to a new file named `.env` in the same directory and fill in
# your API keys. Do NOT commit the `.env` file to Git (ignored by `.gitignore`).
# ==============================================================================

# --- Project Base Configuration ---
PROJECT_NAME="Geospatial Analysis Himalayas"
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR

# --- Google Earth Engine (GEE) ---
# Project ID associated with your Google Cloud Earth Engine account, used by
# workflows/fetch_chirps.py (CHIRPS daily rainfall). One-time host setup:
#   earthengine authenticate   # opens a browser; writes ~/.config/earthengine/credentials
# earthengine-api is baked into the insar image (docker/Dockerfile) -> rebuild once:
#   docker compose build insar
EE_PROJECT_ID="your-gcp-earth-engine-project-id"

# --- Microsoft Planetary Computer ---
# Optional but increases rate limits for PC catalog downloads (Sentinel, Landsat, etc.)
# Get a key at: https://planetarycomputer.microsoft.com/
PLANETARY_COMPUTER_API_KEY="your-planetary-computer-api-key"

# --- Sentinel Hub ---
# Required for Sentinel Hub Python API (sentinelhub)
# Get credentials at: https://www.sentinel-hub.com/
SH_CLIENT_ID="your-sentinel-hub-client-id"
SH_CLIENT_SECRET="your-sentinel-hub-client-secret"

# --- Mapbox (for leafmap, pydeck, folium basemaps) ---
# Create an account at: https://www.mapbox.com/
MAPBOX_API_TOKEN="your-mapbox-public-token"

# --- OpenWeatherMap (optional, for real-time weather querying) ---
# Get a key at: https://openweathermap.org/
OPENWEATHER_API_KEY="your-openweathermap-api-key"

# --- Docker credential mounts (host paths; read by docker-compose.yml) ---
# Recorded here so the containers mount your credentials AUTOMATICALLY — the
# credential files stay in your home dir and are NEVER committed to git. Use
# forward slashes even on Windows (Docker Desktop accepts them), no quotes.
# CDS/ERA5 personal access token for MintPy tropospheric correction (see
# .cdsapirc.template) — mounted into the `mintpy` service:
CDSAPI_RC=C:/Users/<you>/.cdsapirc
# NASA Earthdata ~/.netrc for Phase-1 ASF access — used by the `insar` service:
NETRC_PATH=C:/Users/<you>/.netrc
# Google Earth Engine OAuth credentials for fetch_chirps.py — mounted into `insar`.
# Path on the host to the file written by `earthengine authenticate`:
EE_CREDENTIALS=C:/Users/<you>/.config/earthengine/credentials
